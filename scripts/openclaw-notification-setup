#!/usr/bin/env bash

set -euo pipefail

command_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/openclaw-common.sh
source "$command_dir/openclaw-common.sh"

action="${1:-}"
model="${OPENCLAW_NOTIFICATION_MODEL:-}"
scenario="${OPENCLAW_NOTIFICATION_SCENARIO:-}"
workspace="${OPENCLAW_NOTIFICATION_WORKSPACE:-}"
agent_system_plugin="${OPENCLAW_NOTIFICATION_AGENT_SYSTEM_PLUGIN:-}"
expected_evidence="${OPENCLAW_NOTIFICATION_EXPECTED_EVIDENCE:-}"

usage() {
  cat <<EOF
Usage: ${tty_bold}openclaw-notification-setup${tty_reset} <prepare|evidence|stop> --model <provider/model> ${tty_dim}[options] [--debug]${tty_reset}

${tty_tp}Options:${tty_reset}
  --model <provider/model>       selects the live OpenAI or local AIMock model
  --scenario <id>               selects the checked-in notification scenario
  --workspace <path>            sets the isolated OpenClaw workspace for prepare
  --agent-system-plugin <path>  installs the prepared Agent System package for prepare
  --expected-evidence <path>    compares mock evidence with the checked-in fixture
  --debug                       shows diagnostic messages
  -h, --help                    displays this help message

${tty_tp}Environment Variables:${tty_reset}
  OPENCLAW_NOTIFICATION_MODEL               same as --model
  OPENCLAW_NOTIFICATION_SCENARIO            same as --scenario
  OPENCLAW_NOTIFICATION_WORKSPACE           same as --workspace
  OPENCLAW_NOTIFICATION_AGENT_SYSTEM_PLUGIN same as --agent-system-plugin
  OPENCLAW_NOTIFICATION_EXPECTED_EVIDENCE   same as --expected-evidence
  OPENAI_API_KEY                            required only for an openai model
  TMPDIR                                    owns provider process state and evidence
EOF
}

case "$action" in
  -h | --help)
    usage
    exit 0
    ;;
  prepare | evidence | stop)
    shift
    ;;
  *)
    usage >&2
    error 'an action of prepare, evidence, or stop is required' 2
    ;;
esac

while (($# > 0)); do
  case "$1" in
    --model)
      (($# >= 2)) || error '--model requires a provider/model value' 2
      model="$2"
      shift 2
      ;;
    --scenario)
      (($# >= 2)) || error '--scenario requires an id' 2
      scenario="$2"
      shift 2
      ;;
    --workspace)
      (($# >= 2)) || error '--workspace requires a path' 2
      workspace="$2"
      shift 2
      ;;
    --agent-system-plugin)
      (($# >= 2)) || error '--agent-system-plugin requires a path' 2
      agent_system_plugin="$2"
      shift 2
      ;;
    --expected-evidence)
      (($# >= 2)) || error '--expected-evidence requires a path' 2
      expected_evidence="$2"
      shift 2
      ;;
    --debug)
      enable_debug
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      error "unrecognized option: $1" 2
      ;;
  esac
done

[[ "${GITHUB_ACTIONS:-}" == 'true' ]] || error 'this command may run only in GitHub Actions'
[[ -n "${TMPDIR:-}" ]] || error 'TMPDIR is required for notification setup'
[[ -n "$model" ]] || error '--model or OPENCLAW_NOTIFICATION_MODEL is required' 2

case "$model" in
  openai/*)
    model_provider=live
    [[ -n "${OPENAI_API_KEY:-}" ]] || error 'OPENAI_API_KEY is required for an OpenAI model'
    ;;
  aimock/*)
    model_provider=mock
    [[ -z "${OPENAI_API_KEY:-}" ]] || error 'OPENAI_API_KEY must be empty for an AIMock model'
    ;;
  *)
    error "unsupported notification model: $model" 2
    ;;
esac

provider_base_url='http://127.0.0.1:4010'
provider_log="$TMPDIR/notification-model.log"
provider_pid_path="$TMPDIR/notification-model.pid"
provider_url_path="$TMPDIR/notification-model.url"
provider_evidence_path="$TMPDIR/notification-model-evidence.json"

start_mock_provider() {
  local provider_pid
  local provider_ready=''

  [[ -n "$scenario" ]] || error '--scenario is required for mock preparation' 2
  [[ ! -e "$provider_pid_path" ]] || error "notification model state already exists: $provider_pid_path"

  node --import tsx "$command_dir/github-notification-model-server.ts" \
    --scenario "$scenario" \
    --host 127.0.0.1 \
    --port 4010 \
    >"$provider_url_path" \
    2>"$provider_log" &
  provider_pid="$!"
  printf '%s\n' "$provider_pid" >"$provider_pid_path"

  for _ in {1..30}; do
    if curl --fail --silent --show-error "$provider_base_url/ready" >/dev/null; then
      provider_ready=1
      break
    fi
    if ! kill -0 "$provider_pid" 2>/dev/null; then
      break
    fi
    sleep 1
  done

  if [[ -z "$provider_ready" ]]; then
    tail -n 120 "$provider_log" >&2 || true
    error 'notification model did not become ready'
  fi
  [[ "$(<"$provider_url_path")" == "$provider_base_url" ]] || error 'notification model reported an unexpected base URL'
}

configure_mock_model() {
  local model_config
  local model_defaults
  local model_id="${model#aimock/}"

  [[ -n "$model_id" ]] || error 'the AIMock model id is empty' 2
  model_config="$(
    jq -cn \
      --arg base_url "$provider_base_url" \
      --arg model_id "$model_id" \
      '{baseUrl:$base_url,apiKey:"test",api:"openai-responses",request:{allowPrivateNetwork:true},models:[{id:$model_id,name:$model_id,api:"openai-responses",reasoning:true,input:["text","image"],cost:{input:0,output:0,cacheRead:0,cacheWrite:0},contextWindow:128000,maxTokens:4096}]}'
  )"
  model_defaults="$(jq -cn --arg model "$model" '{($model):{params:{transport:"sse"}}}')"

  openclaw config set models.mode replace
  openclaw config set models.providers.aimock "$model_config" --strict-json
  openclaw models set "$model"
  openclaw config set agents.defaults.models "$model_defaults" --strict-json --merge
  openclaw config validate --json | jq -e '.valid == true'
}

configure_notification_profile() {
  debug 'disabling the unrelated default-agent heartbeat for notification acceptance'
  openclaw config set agents.defaults.heartbeat.every 0m
}

prepare_notification() {
  local -a setup_args=(
    --workspace "$workspace"
    --agent-system-plugin "$agent_system_plugin"
    --needs-secret-service
    --needs-ssh-key
    --yolo
  )

  [[ -n "$scenario" ]] || error '--scenario is required for prepare' 2
  [[ -n "$workspace" ]] || error '--workspace is required for prepare' 2
  [[ "$workspace" == /* ]] || error "workspace must be absolute: $workspace" 2
  [[ -n "$agent_system_plugin" ]] || error '--agent-system-plugin is required for prepare' 2
  [[ "$agent_system_plugin" == /* ]] || error "Agent System plugin path must be absolute: $agent_system_plugin" 2
  [[ -f "$agent_system_plugin" ]] || error "Agent System plugin pack is unavailable: $agent_system_plugin" 2

  if [[ "$model_provider" == mock ]]; then
    start_mock_provider
    "$command_dir/openclaw-setup" "${setup_args[@]}"
  else
    "$command_dir/openclaw-setup" "${setup_args[@]}" --model "$model"
  fi

  configure_notification_profile

  if [[ "$model_provider" == mock ]]; then
    configure_mock_model
  fi
}

compare_evidence() {
  if [[ "$model_provider" == live ]]; then
    return
  fi

  [[ -n "$scenario" ]] || error '--scenario is required for evidence' 2
  [[ -n "$expected_evidence" ]] || error '--expected-evidence is required for mock evidence' 2
  [[ -f "$expected_evidence" ]] || error "expected notification evidence is unavailable: $expected_evidence" 2

  curl --fail --silent --show-error "$provider_base_url/proof/evidence" \
    | tee "$provider_evidence_path"
  jq -e --arg scenario "$scenario" \
    '.schemaVersion == 2 and .scenario == $scenario and .provider == "aimock" and .strictMissCount == 0' \
    "$provider_evidence_path" >/dev/null
  cmp "$expected_evidence" "$provider_evidence_path"
}

stop_notification() {
  local provider_pid

  if [[ "$model_provider" == live || ! -f "$provider_pid_path" ]]; then
    return
  fi

  provider_pid="$(<"$provider_pid_path")"
  require_positive_integer 'notification model pid' "$provider_pid"
  kill -TERM "$provider_pid" 2>/dev/null || true
  for _ in {1..30}; do
    if ! kill -0 "$provider_pid" 2>/dev/null; then
      return
    fi
    sleep 1
  done
  error "notification model did not stop: pid=$provider_pid"
}

case "$action" in
  prepare)
    prepare_notification
    ;;
  evidence)
    compare_evidence
    ;;
  stop)
    stop_notification
    ;;
esac
