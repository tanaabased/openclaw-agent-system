#!/usr/bin/env bash

set -euo pipefail

command_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/openclaw-common.sh
source "$command_dir/openclaw-common.sh"

action="${1:-}"
model="${OPENCLAW_AIMOCK_MODEL:-aimock/gpt-5.5}"
scenario="${OPENCLAW_AIMOCK_SCENARIO:-}"
expected_evidence="${OPENCLAW_AIMOCK_EXPECTED_EVIDENCE:-}"

usage() {
  cat <<EOF
Usage: ${tty_bold}openclaw-aimock${tty_reset} <prepare|evidence|stop> ${tty_dim}[options] [--debug]${tty_reset}

${tty_tp}Options:${tty_reset}
  --model <aimock/model>        selects the local AIMock model
  --scenario <id>               selects one checked-in model scenario
  --expected-evidence <path>    compares observed evidence with the checked-in fixture
  --debug                       shows diagnostic messages
  -h, --help                    displays this help message

${tty_tp}Environment Variables:${tty_reset}
  OPENCLAW_AIMOCK_MODEL             same as --model
  OPENCLAW_AIMOCK_SCENARIO          same as --scenario
  OPENCLAW_AIMOCK_EXPECTED_EVIDENCE same as --expected-evidence
  TMPDIR                            owns provider process state and evidence
EOF
}

case "$action" in
  -h | --help)
    usage
    exit 0
    ;;
  prepare | evidence | stop)
    shift
    ;;
  *)
    usage >&2
    error 'an action of prepare, evidence, or stop is required' 2
    ;;
esac

while (($# > 0)); do
  case "$1" in
    --model)
      (($# >= 2)) || error '--model requires an aimock/model value' 2
      model="$2"
      shift 2
      ;;
    --scenario)
      (($# >= 2)) || error '--scenario requires an id' 2
      scenario="$2"
      shift 2
      ;;
    --expected-evidence)
      (($# >= 2)) || error '--expected-evidence requires a path' 2
      expected_evidence="$2"
      shift 2
      ;;
    --debug)
      enable_debug
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      error "unrecognized option: $1" 2
      ;;
  esac
done

[[ "${GITHUB_ACTIONS:-}" == 'true' ]] || error 'this command may run only in GitHub Actions'
[[ -n "${TMPDIR:-}" ]] || error 'TMPDIR is required for AIMock setup'
[[ "$model" == aimock/* ]] || error "unsupported AIMock model: $model" 2

provider_base_url='http://127.0.0.1:4010'
provider_log="$TMPDIR/openclaw-aimock.log"
provider_pid_path="$TMPDIR/openclaw-aimock.pid"
provider_url_path="$TMPDIR/openclaw-aimock.url"
provider_evidence_path="$TMPDIR/openclaw-aimock-evidence.json"

start_provider() {
  local provider_pid
  local provider_ready=''

  [[ -n "$scenario" ]] || error '--scenario is required for prepare' 2
  [[ ! -e "$provider_pid_path" ]] || error "AIMock state already exists: $provider_pid_path"

  node --import tsx "$command_dir/aimock-server.ts" \
    --scenario "$scenario" \
    --host 127.0.0.1 \
    --port 4010 \
    >"$provider_url_path" \
    2>"$provider_log" &
  provider_pid="$!"
  printf '%s\n' "$provider_pid" >"$provider_pid_path"

  for _ in {1..30}; do
    if curl --fail --silent --show-error "$provider_base_url/ready" >/dev/null; then
      provider_ready=1
      break
    fi
    if ! kill -0 "$provider_pid" 2>/dev/null; then
      break
    fi
    sleep 1
  done

  if [[ -z "$provider_ready" ]]; then
    tail -n 120 "$provider_log" >&2 || true
    error 'AIMock provider did not become ready'
  fi
  [[ "$(<"$provider_url_path")" == "$provider_base_url" ]] || error 'AIMock reported an unexpected base URL'
}

configure_model() {
  local model_config
  local model_defaults
  local model_id="${model#aimock/}"

  [[ -n "$model_id" ]] || error 'the AIMock model id is empty' 2
  model_config="$(
    jq -cn \
      --arg base_url "$provider_base_url" \
      --arg model_id "$model_id" \
      '{baseUrl:$base_url,apiKey:"test",api:"openai-responses",request:{allowPrivateNetwork:true},models:[{id:$model_id,name:$model_id,api:"openai-responses",reasoning:true,input:["text","image"],cost:{input:0,output:0,cacheRead:0,cacheWrite:0},contextWindow:128000,maxTokens:4096}]}'
  )"
  model_defaults="$(jq -cn --arg model "$model" '{($model):{params:{transport:"sse"}}}')"

  openclaw config set models.mode replace
  openclaw config set models.providers.aimock "$model_config" --strict-json
  openclaw models set "$model"
  openclaw config set agents.defaults.models "$model_defaults" --strict-json --merge
  openclaw config validate --json | jq -e '.valid == true'
}

compare_evidence() {
  [[ -n "$scenario" ]] || error '--scenario is required for evidence' 2
  [[ -n "$expected_evidence" ]] || error '--expected-evidence is required for evidence' 2
  [[ -f "$expected_evidence" ]] || error "expected AIMock evidence is unavailable: $expected_evidence" 2

  curl --fail --silent --show-error "$provider_base_url/proof/evidence" \
    | tee "$provider_evidence_path"
  jq -e --arg scenario "$scenario" \
    '.schemaVersion == 2 and .scenario == $scenario and .provider == "aimock" and .strictMissCount == 0' \
    "$provider_evidence_path" >/dev/null
  cmp "$expected_evidence" "$provider_evidence_path"
}

stop_provider() {
  local provider_pid

  [[ -f "$provider_pid_path" ]] || return
  provider_pid="$(<"$provider_pid_path")"
  require_positive_integer 'AIMock pid' "$provider_pid"
  kill -TERM "$provider_pid" 2>/dev/null || true
  for _ in {1..30}; do
    if ! kill -0 "$provider_pid" 2>/dev/null; then
      return
    fi
    sleep 1
  done
  error "AIMock did not stop: pid=$provider_pid"
}

case "$action" in
  prepare)
    start_provider
    configure_model
    ;;
  evidence)
    compare_evidence
    ;;
  stop)
    stop_provider
    ;;
esac
