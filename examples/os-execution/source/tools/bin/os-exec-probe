#!/bin/sh

set -eu

if [ "${1-}" = declared ]; then
  test "$PROBE_SELECTED" = selected-fixture
  test -z "${PROBE_UNRELATED+x}"
  printf '%s\n' declared-child-ready
  exit 0
fi

test "$#" -eq 2
test "$1" = 'argument with spaces'
test -z "$2"
IFS= read -r input
test "$input" = 'input with spaces'
printf '%s\n' os-stdout-ready
printf '%s\n' os-stderr-ready >&2
exit 7
