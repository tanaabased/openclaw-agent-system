#!/bin/sh
set -eu
phase=$1
start_step() {
  step=$1
  printf '%s\n' "$step" > "$TMPDIR/worktree-$phase.current-step"
}
record_failure() {
  rc=$?
  if [ "$rc" -ne 0 ]; then
    printf '%s\n' "$step" > "$TMPDIR/worktree-$phase.failed-step"
  fi
  exit "$rc"
}
start_step record-invocation
trap record_failure EXIT
printf '%s\n' "$phase" >> "$TMPDIR/worktree-probe-invocations"
start_step read-expected-path
expected=$(jq -er .path "$TMPDIR/worktree-remote.json")
start_step working-directory
test "$(pwd -P)" = "$expected"
start_step git-root
test "$(agent-system-git rev-parse --show-toplevel)" = "$expected"
start_step author-identity
agent-system-git var GIT_AUTHOR_IDENT | grep -F 'Worktree Tanaabot <tanaabot@tanaab.dev>'
start_step write-receipt
printf '%s\n' "$expected" > "$TMPDIR/worktree-$phase.pwd"
printf '%s\n' verified > "$TMPDIR/worktree-$phase.receipt"
printf '%s\n' "worktree-$phase-verified"
