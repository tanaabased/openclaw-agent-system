{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "types": ["node"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": [
    "index.ts",
    "agent/**/*.ts",
    "api/**/*.ts",
    "channels/**/*.ts",
    "cli/**/*.ts",
    "core/**/*.ts",
    "credentials/**/*.ts",
    "environment/**/*.ts",
    "manifest/**/*.ts",
    "paths/**/*.ts",
    "tools/**/*.ts",
    "utils/**/*.ts"
  ]
}
