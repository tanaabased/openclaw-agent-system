{
  "name": "@tanaab/openclaw-agent-system",
  "version": "0.1.0",
  "description": "Define reproducible identity, environment, and installation for OpenClaw agent workspaces.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanaabased/openclaw-agent-system.git"
  },
  "homepage": "https://github.com/tanaabased/openclaw-agent-system#readme",
  "bugs": {
    "url": "https://github.com/tanaabased/openclaw-agent-system/issues"
  },
  "keywords": [
    "agent",
    "openclaw",
    "openclaw-plugin",
    "tanaab"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/",
    "index.ts",
    "cli/",
    "lib/",
    "utils/",
    "assets/agent-system.png",
    "openclaw.plugin.json",
    "README.md",
    "ADVANCED.md",
    "DEVELOPMENT.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1-2",
      "minGatewayVersion": "2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    }
  },
  "scripts": {
    "build": "bun scripts/build-task.ts",
    "format:check": "prettier . --check --ignore-unknown",
    "format:write": "prettier . --write --ignore-unknown",
    "leia": "leia",
    "lint:eslint": "eslint .",
    "lint": "bun run lint:eslint && bun run format:check",
    "plugin:check": "bun scripts/check-plugin-task.ts",
    "test:release": "bun scripts/release-test-task.ts",
    "test": "bun run test:unit",
    "test:unit": "node --import tsx ./node_modules/mocha/bin/mocha.js \"test/**/*.spec.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p test/tsconfig.json"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2"
  },
  "dependencies": {
    "@1password/sdk": "0.5.0",
    "@clack/prompts": "1.6.0",
    "ansis": "^4.3.1",
    "camelcase-keys": "6.2.2",
    "kebabcase-keys": "^1.0.0",
    "lodash-es": "4.17.21",
    "typebox": "1.3.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lando/leia": "^1.0.0-beta.4",
    "@types/bun": "^1.3.14",
    "@types/lodash-es": "^4.17.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "clawhub": "0.23.1",
    "commander": "15.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "mocha": "^11.7.6",
    "openclaw": "2026.7.1-2",
    "prettier": "^3.9.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.57.1"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "1.3.0"
  }
}
